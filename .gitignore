# ============================================================
# 教学助手 RAG 项目 .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- 虚拟环境 ----
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.python-version

# ---- 环境变量 / 密钥（绝不入库）----
.env
.env.*
*.pem
*.key
secrets.json
credentials.json

# ---- 数据库 / 向量库（运行时生成，不入库）----
backend/data/app.db
backend/data/app.db-shm
backend/data/app.db-wal
backend/data/*.db
backend/data/*.db-*
backend/data/vectorstore.pkl
backend/data/vectorstore.bin

# ---- 教学助手旧版备份（不入库）----
teachupgarde/

# ---- 打包产物 / 部署载荷（不入库，避免仓库膨胀）----
*.tar.gz
*.tar.bz2
*.zip
*.b64.txt
deploy-payload.b64.txt
teach-v2.tar.gz
teach-v2.tar.gz.b64.txt
teach-v2.zip

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Trae / Claude / Cursor 等开发工具内部目录 ----
.trae/
.claude/
.cursor/

# ---- Node.js（部署脚本依赖）----
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 日志 ----
*.log
logs/
pids/
*.pid

# ---- 测试 / 覆盖率 ----
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints
*.ipynb_checkpoints

# ---- 临时文件 ----
*.tmp
*.temp
*.bak
*.orig
